#!/bin/bash
#!
#! Example SLURM job script for Wilkes3 (AMD EPYC 7763, ConnectX-6, A100)
#!

#! sbatch directives begin here ###############################
#SBATCH -J sch_19H_2nodes_2
#SBATCH -A SCHEMM-SL3-GPU
#! How many whole nodes should be allocated?
#SBATCH --nodes=2
#! How many (MPI) tasks will there be in total? (1 task per node)
#SBATCH --ntasks=2
#SBATCH --ntasks-per-node=1
#! Specify the number of GPUs per node
#SBATCH --gres=gpu:4
#! Specify the number of CPUs per task
#SBATCH --cpus-per-task=128
#! How much wallclock time will be required?
#SBATCH --time=03:00:00
#SBATCH --mail-type=ALL
#SBATCH --signal=TERM@60

#! Uncomment this to prevent the job from being requeued
##SBATCH --no-requeue

#! Do not change:
#SBATCH -p ampere
#! sbatch directives end here ###############################

numnodes=$SLURM_JOB_NUM_NODES
numtasks=$SLURM_NTASKS
mpi_tasks_per_node=$(echo "$SLURM_TASKS_PER_NODE" | sed -e  's/^\([0-9][0-9]*\).*$/\1/')
workdir="$PWD"

. /etc/profile.d/modules.sh

module purge
module load rhel8/default-amp
module load gcc/11
module load cuda/12.1

source /rds/user/jc2405/hpc-work/JaQMC/jaqmc/.venv/bin/activate

# ==============================================================================
# --- DYNAMICALLY LOAD ALL VENV NVIDIA LIBRARIES ---
# ==============================================================================
export VENV_LIB="/rds/user/jc2405/hpc-work/JaQMC/jaqmc/.venv/lib/python3.12/site-packages"

for libdir in "$VENV_LIB"/nvidia/*/lib; do
    export LD_LIBRARY_PATH="$libdir:$LD_LIBRARY_PATH"
done
# ==============================================================================


export OMP_NUM_THREADS=32
export JAX_LOG_COMPILES=1
export JAX_COMPILATION_CACHE_DIR="/rds/user/jc2405/hpc-work/JaQMC/jaqmc/runs/jax_cache/sc_h_19H"
export JAX_PERSISTENT_CACHE_MIN_ENTRY_SIZE_BYTES=-1

np=$[${numnodes}*${mpi_tasks_per_node}]

# ==============================================================================
# --- MULTI-NODE COORDINATION SETUP ---
# ==============================================================================
# Get the hostname of the first node to act as the coordinator
MASTER_ADDR=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n1)
MASTER_PORT=29500


###############################################################
### You should not have to change anything below this line ####
###############################################################

cd $workdir
echo -e "Changed directory to `pwd`.\n"

JOBID=$SLURM_JOB_ID

echo -e "JobID: $JOBID\n======"
echo "Time: `date`"
echo "Running on master node: `hostname`"
echo "Current directory: `pwd`"
echo -e "Multi-node setup: Coordinator is $MASTER_ADDR:$MASTER_PORT"

if [ "$SLURM_JOB_NODELIST" ]; then
        #! Create a machine file:
        export NODEFILE=`generate_pbs_nodefile`
        cat $NODEFILE | uniq > machine.file.$JOBID
        echo -e "\nNodes allocated:\n================"
        echo `cat machine.file.$JOBID | sed -e 's/\..*$//g'`
fi

echo -e "\nnumtasks=$numtasks, numnodes=$numnodes, mpi_tasks_per_node=$mpi_tasks_per_node (OMP_NUM_THREADS=$OMP_NUM_THREADS)"

echo -e "\n--- RUNNING JAX DEVICE TEST ---"
srun --ntasks-per-node=1 --gpus-per-task=4 bash -c '
  # Apply the exact same blinders to the test environment
  unset SLURM_LOCALID SLURM_PROCID SLURM_NTASKS SLURM_NODEID
  export CUDA_VISIBLE_DEVICES=0,1,2,3
  
  echo "========== HOST: $(hostname) =========="
  echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
  nvidia-smi -L
  python -c "import jax; print(\"JAX LOCAL DEVICES:\", jax.local_devices())"
  echo "======================================="
'
echo -e "--- TEST COMPLETE ---\n"

echo -e "\nExecuting srun command...\n"

# Wrap the execution in bash -c.
# Notice the double quotes around the whole command, but the \$ before SLURM_PROCID.
# This allows MASTER_ADDR to be evaluated immediately, but forces the node's local bash to evaluate the PROCID.
# Notice the addition of 'export CUDA_VISIBLE_DEVICES=0,1,2,3;' and the 'unset' command
srun --ntasks-per-node=1 --gpus-per-task=4 bash -c " \
  PROCID=\$SLURM_PROCID; \
  unset SLURM_LOCALID SLURM_PROCID SLURM_NTASKS SLURM_NODEID; \
  export CUDA_VISIBLE_DEVICES=0,1,2,3; \
  unset SOCKS_PROXY_PORT SOCKS_PROXY_NETWORK SOCKS_PROXY_SERVER; \
  exec jaqmc solid train \
  --yml /rds/user/jc2405/hpc-work/JaQMC/jaqmc/configs/sc_h_chain_rdm_sparse_19H.yml \
  workflow.save_path=/rds/user/jc2405/hpc-work/JaQMC/jaqmc/runs/sc_h_chain_rdm_sparse_19H \
  distributed.coordinator_address=${MASTER_ADDR}:${MASTER_PORT} \
  distributed.num_processes=${SLURM_NTASKS} \
  distributed.process_id=\$PROCID"
