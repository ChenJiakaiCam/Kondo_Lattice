#!/bin/bash
#!
#! Example SLURM job script for Wilkes3 (AMD EPYC 7763, ConnectX-6, A100)
#!

#!#############################################################
#!#### Modify the options in this section as appropriate ######
#!#############################################################

#! sbatch directives begin here ###############################
#! Name of the job:
#SBATCH -J sc_h_chain_rdm_eval_batch
#! Which project should be charged (NB Wilkes2 projects end in '-GPU'):
#SBATCH -A SCHEMM-SL3-GPU
#! How many whole nodes should be allocated?
#SBATCH --nodes=1
#! How many (MPI) tasks will there be in total?
#SBATCH --ntasks=1
#! Specify the number of GPUs per node
#SBATCH --gres=gpu:4
#! How much wallclock time will be required?
#SBATCH --time=00:30:00
#! What types of email messages do you wish to receive?
#SBATCH --mail-type=ALL,ARRAY_TASKS
#! Uncomment this to prevent the job from being requeued
##SBATCH --no-requeue

#! Submit a job array with index values between 1 and 5
#SBATCH --array=3
#! Output and Error filenames (%A is the job array ID, %a is the array index):
#SBATCH --output=sc_h_chain_rdm_eval_%A_%a.out
#SBATCH --error=sc_h_chain_rdm_eval_%A_%a.err

#! Do not change:
#SBATCH -p ampere

#! sbatch directives end here (put any additional directives above this line)

numnodes=$SLURM_JOB_NUM_NODES
numtasks=$SLURM_NTASKS
mpi_tasks_per_node=$(echo "$SLURM_TASKS_PER_NODE" | sed -e  's/^\([0-9][0-9]*\).*$/\1/')
#! Work directory (i.e. where the job will run):
workdir="$SLURM_SUBMIT_DIR"  # The value of SLURM_SUBMIT_DIR sets workdir to the directory
                             # in which sbatch is run.

#!#############################################################

. /etc/profile.d/modules.sh

module purge
# For GPU
module load rhel8/default-amp
module load gcc/11
module load cuda/12.1

source /rds/user/jc2405/hpc-work/JaQMC/jaqmc/.venv/bin/activate

# ==============================================================================
# --- DYNAMICALLY LOAD ALL VENV NVIDIA LIBRARIES ---
# ==============================================================================
export VENV_LIB="/rds/user/jc2405/hpc-work/JaQMC/jaqmc/.venv/lib/python3.12/site-packages"

for libdir in "$VENV_LIB"/nvidia/*/lib; do
    export LD_LIBRARY_PATH="$libdir:$LD_LIBRARY_PATH"
done
# ==============================================================================

export OMP_NUM_THREADS=1

np=$[${numnodes}*${mpi_tasks_per_node}]

# Grab the array index for this specific job task
J_IDX=$SLURM_ARRAY_TASK_ID

#/rds/user/jc2405/hpc-work/JaQMC/jaqmc/configs/sc_h_chain_rdm_3d6.yml
#/rds/user/jc2405/hpc-work/JaQMC/jaqmc/runs/sc_h_chain_3.78_spin_6_6
# Use J_IDX to dynamically format the yml file name and save_path
CMD="jaqmc solid evaluate --yml ./configs/sc_h_chain_rdm_3d${J_IDX}.yml \
workflow.save_path=./runs/sc_h_chain_rdm_3d${J_IDX}_eval \
workflow.source_path=./runs/sc_h_chain_3.78_spin_6_6 \
workflow.config.ignore_extra=True"

###############################################################
### You should not have to change anything below this line ####
###############################################################

cd $workdir
echo -e "Changed directory to `pwd`.\n"

JOBID=$SLURM_JOB_ID

echo -e "JobID: $JOBID\n======"
echo "Array Task ID: $SLURM_ARRAY_TASK_ID"
echo "Time: `date`"
echo "Running on master node: `hostname`"
echo "Current directory: `pwd`"

if [ "$SLURM_JOB_NODELIST" ]; then
        #! Create a machine file:
        export NODEFILE=`generate_pbs_nodefile`
        cat $NODEFILE | uniq > machine.file.${JOBID}_${SLURM_ARRAY_TASK_ID}
        echo -e "\nNodes allocated:\n================"
        echo `cat machine.file.${JOBID}_${SLURM_ARRAY_TASK_ID} | sed -e 's/\..*$//g'`
fi

echo -e "\nnumtasks=$numtasks, numnodes=$numnodes, mpi_tasks_per_node=$mpi_tasks_per_node (OMP_NUM_THREADS=$OMP_NUM_THREADS)"

echo -e "\nExecuting command:\n==================\n$CMD\n"

eval $CMD